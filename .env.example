# Server-only (never NEXT_PUBLIC_*): /api/submit-lead adds these before forwarding to the CRM.
BASE_ENDPOINT=
BASE_API_KEY=
# Leads log: every lead the CRM accepts is also posted here (skipped when the key is empty).
LEADS_LOG_ENDPOINT=https://alphamastercrm.online/api/leads-logs
LEADS_LOG_API_KEY=
# Local dev only: IP sent with test leads when there is no proxy header.
DEV_IP_ADDRESS=

# Meta (Facebook) Pixel ID — digits only. Leave empty to disable the pixel.
# Read on the server only (see app/lib/config.ts).
META_PIXEL_ID=
